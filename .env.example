SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=enjoy_agent
DB_USERNAME=enjoy
DB_PASSWORD=enjoy123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=750ms

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

ES_PORT=9200
ES_JAVA_OPTS="-Xms512m -Xmx512m"

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enjoy-agent
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_BILLING_ENABLED=true
APP_KNOWLEDGE_SEARCH_ENABLED=true
APP_KNOWLEDGE_SEARCH_BASE_URL=http://localhost:9200

APP_JWT_SECRET=change-me-to-a-long-random-string
APP_CREDENTIAL_AES_KEY=0123456789abcdef0123456789abcdef

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=enjoy-agent
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

APP_CACHE_SESSION_SUMMARY_ENABLED=true
APP_HIBERNATE_STATISTICS=true
# Stage 2 cache experiment switches
APP_CACHE_AGENT_CONFIG_ENABLED=true
APP_CACHE_AGENT_CONFIG_LOCAL_ENABLED=true
APP_CACHE_AGENT_CONFIG_LOCK_ENABLED=true
APP_CACHE_AUTH_CONTEXT_ENABLED=true
APP_CACHE_AUTH_CONTEXT_LOCAL_ENABLED=true

# Stage 3 reliable asynchronous document ingestion
APP_KNOWLEDGE_ASYNC_INGEST_ENABLED=true
APP_KNOWLEDGE_EMBEDDING_BATCH_SIZE=20
APP_KNOWLEDGE_INGEST_WORKER_CONCURRENCY=4
APP_KNOWLEDGE_INGEST_PREFETCH=2
APP_KNOWLEDGE_INGEST_MAX_ATTEMPTS=3
APP_KNOWLEDGE_INGEST_RETRY_DELAYS=5s,30s
