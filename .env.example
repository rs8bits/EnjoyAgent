SERVER_PORT=8080
BIND_ADDRESS=127.0.0.1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=enjoy_agent
DB_USERNAME=enjoy
DB_PASSWORD=enjoy123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=750ms

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

ES_PORT=9200
ES_JAVA_OPTS="-Xms512m -Xmx512m"

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enjoy-agent
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_MCP_OAUTH_PUBLIC_BASE_URL=http://localhost:8080

APP_BILLING_ENABLED=true
APP_BILLING_RESERVATION_OUTPUT_TOKENS=4096
APP_BILLING_RESERVATION_MAX_INPUT_TOKENS=1000000
APP_BILLING_RESERVATION_MAX_OUTPUT_TOKENS=131072
APP_BILLING_RESERVATION_TTL=10m
APP_BILLING_PROCESSING_MAX_ATTEMPTS=5
APP_BILLING_RABBIT_PUBLISHER_CONFIRM_TIMEOUT=5s
APP_BILLING_RABBIT_OUTBOX_CLAIM_TIMEOUT=30s
APP_BILLING_RABBIT_RECONCILIATION_DELAY=1m
APP_BILLING_RABBIT_OUTBOX_BATCH_SIZE=50
APP_KNOWLEDGE_SEARCH_ENABLED=true
APP_KNOWLEDGE_SEARCH_BASE_URL=http://localhost:9200

# 仅供 SPRING_PROFILES_ACTIVE=local/perf；默认/生产 profile 会拒绝这些已知开发值。
APP_JWT_SECRET=change-me-to-a-long-random-string
# JWT 平滑轮换格式：old-kid=old-secret,older-kid=older-secret
APP_PREVIOUS_JWT_KEYS=
APP_CREDENTIAL_AES_KEY=0123456789abcdef0123456789abcdef
# 轮换时以逗号分隔保留历史 AES key；确认旧密文已重加密后再移除。
APP_CREDENTIAL_PREVIOUS_AES_KEYS=

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=enjoy-agent
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

APP_CACHE_SESSION_SUMMARY_ENABLED=true
APP_HIBERNATE_STATISTICS=true
# Stage 2 cache experiment switches
APP_CACHE_AGENT_CONFIG_ENABLED=true
APP_CACHE_AGENT_CONFIG_LOCAL_ENABLED=true
APP_CACHE_AGENT_CONFIG_LOCK_ENABLED=true
APP_CACHE_AUTH_CONTEXT_ENABLED=true
APP_CACHE_AUTH_CONTEXT_LOCAL_ENABLED=true

# Stage 3 reliable asynchronous document ingestion
APP_KNOWLEDGE_ASYNC_INGEST_ENABLED=true
APP_KNOWLEDGE_EMBEDDING_BATCH_SIZE=20
APP_KNOWLEDGE_MAX_FILE_SIZE_BYTES=20971520
APP_KNOWLEDGE_MAX_PDF_PAGES=500
APP_KNOWLEDGE_MAX_EXTRACTED_TEXT_CHARS=2000000
APP_KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=10000
APP_KNOWLEDGE_MAX_ACTIVE_IMPORTS_PER_TENANT=8
APP_KNOWLEDGE_MAX_DOCUMENTS_PER_TENANT=1000
APP_KNOWLEDGE_MAX_SOURCE_BYTES_PER_TENANT=2147483648
APP_KNOWLEDGE_MAX_CHUNKS_PER_TENANT=200000
APP_KNOWLEDGE_EXTRACTION_TIMEOUT=2m
APP_KNOWLEDGE_MAX_CONCURRENT_EXTRACTIONS=4
APP_KNOWLEDGE_EXTRACTION_ADMISSION_TIMEOUT=1s
APP_KNOWLEDGE_EMBEDDING_REQUEST_TIMEOUT=30s
APP_KNOWLEDGE_EMBEDDING_MAX_RESPONSE_BYTES=8388608
APP_KNOWLEDGE_RERANK_REQUEST_TIMEOUT=15s
APP_KNOWLEDGE_RERANK_MAX_RESPONSE_BYTES=1048576
APP_KNOWLEDGE_INGEST_WORKER_CONCURRENCY=4
APP_KNOWLEDGE_INGEST_PREFETCH=2
APP_KNOWLEDGE_INGEST_MAX_ATTEMPTS=3
APP_KNOWLEDGE_INGEST_RETRY_DELAYS=5s,30s
APP_KNOWLEDGE_INGEST_PROCESSING_LEASE_DURATION=10m
APP_KNOWLEDGE_INGEST_LEASE_REAPER_BATCH_SIZE=50
APP_KNOWLEDGE_INGEST_CLEANUP_BATCH_SIZE=20
APP_KNOWLEDGE_INGEST_CLEANUP_GRACE_PERIOD=30s
APP_KNOWLEDGE_INGEST_CLEANUP_CLAIM_TIMEOUT=2m
APP_KNOWLEDGE_INGEST_CLEANUP_RETRY_DELAY=10s
